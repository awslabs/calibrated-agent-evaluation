# Dev connection settings for the local Langfuse stack (docker/langfuse/docker-compose.yml).
# Copy to your shell env (or `set -a; source this; set +a`) before running the integration
# test or `just seed-fixture langfuse`. These match the auto-provisioned dev project in the
# compose file. These are dev defaults for a loopback-only dev stack: the compose file publishes
# its ports on 127.0.0.1 only. Never use them for an instance another machine can reach.

LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-calibrated-agent-evaluation-dev
LANGFUSE_SECRET_KEY=sk-lf-calibrated-agent-evaluation-dev

# OSS build, telemetry off. The Calibrated Agent Evaluation LangfuseBackend also sets this itself.
TELEMETRY_ENABLED=false

# ---------------------------------------------------------------------------
# Compose-stack credentials (docker/langfuse/docker-compose.yml).
#
# The compose file holds no credential value: each is a required `${VAR:?...}` reference.
# `just langfuse-up` passes this file as --env-file, or docker/langfuse/.env when that exists
# (copy this file there to override). Running compose by hand, pass
# `--env-file docker/langfuse/.env.example`.
#
# For ANY non-local deployment you MUST replace every value here. Generate a real encryption
# key with `openssl rand -hex 32` and a real NEXTAUTH_SECRET/SALT the same way.
# ---------------------------------------------------------------------------

# Datastore credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
REDIS_AUTH=redis
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret

# Langfuse app secrets — the defaults are OBVIOUS placeholders, not real secrets.
NEXTAUTH_SECRET=dev-nextauth-secret-not-for-production
SALT=dev-salt-not-for-production
# 64 hex chars (Langfuse validates the length). Placeholder only — set your own for real use.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Auto-provisioned dev project keys (match LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY above).
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-calibrated-agent-evaluation-dev
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-calibrated-agent-evaluation-dev
LANGFUSE_INIT_USER_PASSWORD=dev-password-12345
