# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# uv
# (uv.lock IS committed; the environment is not)

# Test / coverage / type-check caches
.pytest_cache/
.ruff_cache/
.nox/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.pyright/
.mypy_cache/

# Editors / OS
.idea/
.vscode/
.DS_Store

# Local AI-assistant configuration (kept out of the shared tree)
.claude/
.kiro/
CLAUDE.md
.mcp.json

# MkDocs documentation-site build output (generated; the sources under docs/site/ ARE committed)
docs/site/_site/

# Local backend store written by `just seed-fixture local` (generated, not source)
.calibrated-agent-evaluation/
# FastHTML session-signing secret, auto-created on first app start (a generated secret, never source)
.sesskey
.hypothesis/

# Inspect AI eval logs generated at runtime by the executor (the committed fixtures
# in fixtures/raw/inspect/*.eval are tracked explicitly via git add -f)
*.eval
!fixtures/raw/inspect/*.eval

.scratch/

# advisory lock files cassette writers hold while merging
.*.json.lock
checklist.md
